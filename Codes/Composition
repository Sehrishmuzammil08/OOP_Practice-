  class Laptop:
    def __init__(self, brand, ram):
        self.brand = brand
        self.ram = ram

class Student:
    def __init__(self, name, cgpa, laptop):
        self.name = name
        self.cgpa = cgpa
        self.laptop = laptop  # Composition

class University:
    def __init__(self, name):
        self.name = name
        self.students = []  # Students list

    def add_student(self, student):
        self.students.append(student)

    def print_students(self):
        print(f"University: {self.name}")
        for s in self.students:
            print(f"Student: {s.name}, CGPA: {s.cgpa}, "
                  f"Laptop: {s.laptop.brand}, RAM: {s.laptop.ram} GB")

lap1 = Laptop("Dell", 8)
lap2 = Laptop("HP", 16)

st1 = Student("Sehrish", 3.7, lap1)
st2 = Student("Ayesha", 3.5, lap2)

uni = University("GCUF")
uni.add_student(st1)
uni.add_student(st2)
uni.print_students()


