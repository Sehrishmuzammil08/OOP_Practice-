class Engine:
    def __init__(self, horsepower):
        self.horsepower = horsepower

    def start(self):
        print(f"Engine started with {self.horsepower} HP")

class Car:
    def __init__(self, brand, model, engine):
        self.brand = brand
        self.model = model
        self.engine = engine  # Composition

    def start_car(self):
        self.engine.start()  

engine1 = Engine(150)
car1 = Car("Toyota", "Corolla", engine1)
car1.start_car()



