  class Room:
    def __init__(self, name, area):
        self.name = name
        self.area = area
  
class House:
    def __init__(self, address):
        self.address = address
        self.rooms = []

    def add_room(self, room):
        self.rooms.append(room)

    def total_area(self):
        return sum(room.area for room in self.rooms)

house = House("Street 5, Sargodha")
house.add_room(Room("Bedroom", 150))
house.add_room(Room("Kitchen", 80))
house.add_room(Room("Living Room", 200))

print("Total area:", house.total_area(), "sq ft")


