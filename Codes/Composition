class Product:
    def __init__(self, name, price):
        self.name = name
        self.price = price

class Cart:
    def __init__(self):
        self.products = []

    def add_product(self, product):
        self.products.append(product)

    def remove_product(self, product):
        if product in self.products:
            self.products.remove(product)

    def total_bill(self):
        return sum(p.price for p in self.products)


class Customer:
    def __init__(self, name, email):
        self.name = name
        self.email = email
        self.cart = Cart()  # Composition

p1 = Product("Shirt", 1500)
p2 = Product("Shoes", 3000)
p3 = Product("Cap", 500)

customer = Customer("Ahmed", "ahmed@example.com")
customer.cart.add_product(p1)
customer.cart.add_product(p2)
customer.cart.add_product(p3)

customer.cart.remove_product(p3)  # 

print("Final bill:", customer.cart.total_bill())
  
