class Author:
    def __init__(self, name, age):
        self.name = name
        self.age = age
  
class Book:
    def __init__(self, title, price, author):
        self.title = title
        self.price = price
        self.author = author  # Composition

author1 = Author("Ali Raza", 40)
book1 = Book("Python Basics", 1200, author1)
book2 = Book("Data Structures", 1500, author1)

for book in (book1, book2):
    print(f"Book {book.title} by {book.author.name} costs {book.price}")


